# ── TrustScore environment ────────────────────────────────────────────────
# Copy to .env and fill in. The sandbox defaults are honest: the platform
# boots in MOCK provider posture with no external calls.
#
# sec-batch-A BOOT GUARD: the four REQUIRED-IN-PRODUCTION secrets below
# (VAULT_MASTER_KEY, SIGNAL_PEPPER, NINAUTH_CLIENT_SECRET,
# LOOPBACK_SIGNING_SECRET) are checked at boot. In production the platform
# REFUSES to serve traffic when any of them is missing, equal to a dev
# default, equal to one of the placeholder values in this file, or shorter
# than 16 characters. Dev runs with a loud warning instead (MOCK posture).
# Observe live posture via GET /api/v1/admin/security-posture (ADMIN only).

# Database (Prisma / SQLite)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Identity hashing pepper — salted fingerprints for phone/email identifiers.
# CHANGE THIS IN PRODUCTION (any long random string).
SIGNAL_PEPPER=dev-only-pepper-change-me

# ── Trusted-proxy boundary (rate limiting / session IP hashes) ────────────
# Number of APPENDING reverse proxies in front of the app (sandbox: 1, the
# Caddy gateway). Client IPs are taken from the RIGHTMOST X-Forwarded-For
# hops (proxy-appended = trustworthy); leftmost entries are client-spoofable.
TS_TRUSTED_PROXY_HOPS=1

# Sandbox-only escape hatch: exercise the production nonce-CSP path in dev
# (default dev CSP keeps 'unsafe-inline' for Turbopack HMR). Leave unset.
# TS_FORCE_NONCE_CSP=1

# ── Provider posture (Stage 13 live-ready transport) ─────────────────────
# LIVE is honestly gated: the API refuses the flip until partner credentials
# + base URLs exist AND this flag is set.
PROVIDER_LIVE_ENABLED=false

# NINAuth (NIMC identity consent gateway) — LIVE partner credentials
NINAUTH_BASE_URL=
NINAUTH_CLIENT_SECRET=

# Phone (SMS OTP) provider
PHONE_BASE_URL=

# Biometric (liveness) provider
LIVENESS_BASE_URL=

# Loopback posture — the local provider simulator (mini-services/provider-simulator)
LOOPBACK_BASE_URL=http://127.0.0.1:3032
LOOPBACK_SIGNING_SECRET=loopback-dev-secret

# HMAC signing key for provider transport calls (loopback/dev)
TRANSPORT_HMAC_KEY=dev-transport-hmac-key

# AES-256-GCM master key for the provider credential vault.
# CHANGE THIS IN PRODUCTION (32+ bytes, base64 or hex).
VAULT_MASTER_KEY=

# B2B webhook signing secret (HMAC-SHA256 deliveries)
TRUSTSCORE_WEBHOOK_SECRET=dev-webhook-secret
