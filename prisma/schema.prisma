// TrustScore — NIN-First rebuild
// Stage 1–7 schema (per docs/STAGE0_AUDIT.md §4.3 / §4.2)
//
// Principle: UserAccount ≠ TrustIdentity ≠ NIN ≠ Phone (directive §29).
// Raw identity numbers (NIN, BVN, raw phone) are NEVER stored here.
// Stage 3 added the Trust Identity management layer: hashed identifiers,
// consent-scoped attributes, evidence records with provenance + freshness.
// Stage 4 adds phone (OTP) + biometric (liveness) verification sessions —
// contract-first MOCK providers; raw phone numbers are stored ONLY as
// peppered sha256 fingerprints with masked display hints.
// Stage 7 adds the reputation layer: flags with evidence, human-reviewed
// resolutions, appeals — anti-gaming by design (L2 reporter gate, one
// open flag per pair, 3-per-7-day quota, mandatory evidence).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Stage 1 — Accounts (authentication subjects)
// ---------------------------------------------------------------------------

model UserAccount {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String // scrypt output (never plaintext, never reversible)
  passwordSalt    String // per-user random salt
  displayName     String
  handle          String   @unique // reserved for future trustscore.ng/@handle Trust Link (Stage 5)
  status          String   @default("ACTIVE") // ACTIVE | SUSPENDED | PENDING_DELETION
  role            String   @default("USER") // USER | REVIEWER — reviewer role grants human-review queue access (operational grant, never self-service)
  acceptedTermsAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions             Session[]
  notifications        Notification[]
  trustIdentity        TrustIdentity?
  verificationSessions VerificationSession[]
  consents             Consent[]
  evidence             Evidence[]
  phoneVerifications   PhoneVerification[]
  livenessSessions     LivenessSession[]
  scoreSnapshots      TrustScoreSnapshot[]
  credentials          Credential[]
  shareTokens          ShareToken[]
  trustReceipts        TrustReceipt[]
  dsrRequests          DsrRequest[]
  safetyChecksMade     SafetyCheck[]     @relation("SafetyChecksMade")
  safetyChecksReceived SafetyCheck[]     @relation("SafetyChecksReceived")
  trustRequestsSent    TrustRequest[]    @relation("TrustRequestsSent")
  trustRequestsReceived TrustRequest[]   @relation("TrustRequestsReceived")
  flagsFiled          Flag[]            @relation("FlagsFiled")
  flagsReceived       Flag[]            @relation("FlagsReceived")
  flagResolutions     FlagResolution[]  @relation("FlagResolutions")
  flagAppeals         FlagAppeal[]      @relation("FlagAppeals")

  @@index([email])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Stage 2 — NINAuth identity spine (contract-first, MOCK provider)
// Raw NIN / raw identifiers are NEVER stored. The provider returns only a
// masked subject reference (providerIdentityRef) + verification outcome.
// ---------------------------------------------------------------------------

model TrustIdentity {
  id                    String    @id @default(cuid())
  userId                String    @unique
  status                String    @default("PENDING") // PENDING | VERIFIED | EXPIRED | REVOKED
  assuranceLevel        Int       @default(0) // 0 = none; 1 = government-verified via NINAuth; L2 phone/L3 biometric arrive Stage 4; L4 cross-signal
  provider              String    @default("NINAUTH_MOCK")
  providerMode          String    @default("MOCK") // MOCK until partner sandbox creds exist (audit §2.2)
  providerIdentityRef   String? // masked subject from provider — never a raw NIN
  establishingConsentId String? // the consent that established this identity (withdrawal semantics, Stage 3)
  verifiedAt            DateTime?
  expiresAt             DateTime? // verification freshness horizon (90 days)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user        UserAccount          @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifiers IdentityIdentifier[]
  attributes  IdentityAttribute[]
  evidence    Evidence[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Stage 3 — Identity identifiers (HASHED — directive §29 identity_identifiers)
// We store only peppered sha256 fingerprints for future match lookops
// (Stage 6 Safety Check) — never raw NIN/phone values.
// ---------------------------------------------------------------------------

model IdentityIdentifier {
  id              String    @id @default(cuid())
  trustIdentityId String
  type            String // NIN_FINGERPRINT | PHONE | EMAIL — signal family
  hash            String // sha256(pepper + provider subject / normalized value) — NEVER raw
  hint            String // masked display hint, e.g. "Government ID · NINAuth ref"
  status          String    @default("ACTIVE") // ACTIVE | REVOKED | SUPERSEDED
  verifiedAt      DateTime
  expiresAt       DateTime? // identifier freshness horizon
  consentId       String? // provenance
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trustIdentity TrustIdentity @relation(fields: [trustIdentityId], references: [id], onDelete: Cascade)

  @@unique([trustIdentityId, type])
  @@index([hash])
}

// ---------------------------------------------------------------------------
// Stage 3 — Identity attributes (CONSENT-SCOPED — directive §29/§31)
// An attribute exists only while the consent that produced it stands.
// Withdrawing the consent revokes the attribute (NDPA data-subject right).
// ---------------------------------------------------------------------------

model IdentityAttribute {
  id              String    @id @default(cuid())
  trustIdentityId String
  key             String // given_name | family_name | birth_year | state_of_origin | ...
  value           String // consent-scoped display value
  scope           String // the consent scope that produced this attribute
  consentId       String // provenance — withdraw the consent, revoke the attribute
  status          String    @default("ACTIVE") // ACTIVE | REVOKED
  source          String // provider that asserted the value
  assertedAt      DateTime // when the provider asserted it
  expiresAt       DateTime? // attribute freshness (follows identity horizon)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trustIdentity TrustIdentity @relation(fields: [trustIdentityId], references: [id], onDelete: Cascade)

  @@unique([trustIdentityId, key])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Stage 3 — Evidence records (provenance + freshness — directive §29 evidence)
// Verified evidence with chain: which session produced it, under which consent,
// from which provider, with what confidence, valid until when.
// ---------------------------------------------------------------------------

model Evidence {
  id              String    @id @default(cuid())
  userId          String
  trustIdentityId String?
  sessionId       String? // verification session provenance
  consentId       String? // consent provenance
  type            String // NINAUTH_ID_TOKEN | PHONE_OTP | LIVENESS (Stage 4) | ...
  provider        String
  providerMode    String
  summary         String // redacted human summary — no PII (directive §38)
  confidence      Int       @default(100) // 0–100 provider confidence
  status          String    @default("ACTIVE") // ACTIVE | REVOKED
  collectedAt     DateTime
  expiresAt       DateTime? // evidence freshness
  createdAt       DateTime  @default(now())

  user          UserAccount    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trustIdentity TrustIdentity? @relation(fields: [trustIdentityId], references: [id], onDelete: SetNull)

  @@index([userId, collectedAt])
  @@index([trustIdentityId])
  @@index([status])
}

model VerificationSession {
  id                    String    @id @default(cuid())
  userId                String
  provider              String    @default("NINAUTH_MOCK")
  providerMode          String    @default("MOCK")
  flow                  String    @default("QR") // QR | SHARE_CODE
  status                String    @default("AWAITING_CONSENT") // AWAITING_CONSENT | CONSENT_GRANTED | CONSENT_DENIED | COMPLETED | FAILED | EXPIRED
  state                 String    @unique // OAuth state / anti-CSRF (also used as nonce)
  codeVerifier          String // PKCE verifier — SERVER-SIDE ONLY, never sent to any client
  codeChallenge         String // S256(verifier)
  authorizationCodeHash String? // one-time code issued by the provider (mock NINAuth app)
  authorizationCodeExp  DateTime?
  scopes                String // JSON array requested/granted
  purpose               String
  policyVersion         String
  shareCode             String    @unique // NINAuth-style share code for the user to present
  authorizationUrl      String // provider authorize URL (mock endpoint shape in sandbox)
  errorReason           String?
  consentId             String?
  expiresAt             DateTime // session TTL (10 min, like an authorize flow)
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  events VerificationEvent[]
  user   UserAccount         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model VerificationEvent {
  id        String   @id @default(cuid())
  sessionId String
  eventType String // SESSION_CREATED | CONSENT_SCREEN_PRESENTED | CONSENT_GRANTED | CONSENT_DENIED | CODE_ISSUED | CODE_EXCHANGED | TOKEN_VALIDATED | IDENTITY_VERIFIED | SESSION_FAILED | SESSION_EXPIRED
  detail    String? // redacted JSON — no PII (directive §38)
  createdAt DateTime @default(now())

  session VerificationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// Consent record per directive §31: who requested, why, what scopes were
// requested/granted, when, which provider, policy version.
model Consent {
  id            String    @id @default(cuid())
  userId        String
  sessionId     String?   @unique
  requester     String // who requested the identity access
  purpose       String
  scopes        String // JSON array granted
  policyVersion String
  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?
  createdAt     DateTime  @default(now())

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Stage 4 — Phone verification (OTP, contract-first MOCK SMS transport).
// The raw phone number NEVER lands in this table: only a peppered sha256
// fingerprint (matching Stage 3 identifier discipline) + a masked display
// hint. The OTP itself is stored hashed; attempts are capped server-side.
// ---------------------------------------------------------------------------

model PhoneVerification {
  id          String    @id @default(cuid())
  userId      String
  phoneHash   String // sha256(pepper + E.164) — NEVER raw phone
  phoneHint   String // masked display hint, e.g. "+234 8•• ••• ••34"
  status      String    @default("PENDING") // PENDING | VERIFIED | FAILED | EXPIRED
  otpHash     String // sha256(pepper + code) — never plaintext
  attempts    Int       @default(0) // wrong-OTP attempts (max 3, reset on resend)
  resends     Int       @default(0) // resend count (max 3)
  simSwapRisk String    @default("LOW") // LOW | MEDIUM | HIGH — mock network signal
  consentId   String // the consent that authorized this verification
  expiresAt   DateTime // OTP TTL (5 minutes)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Stage 4 — Biometric liveness (selfie/liveness, Smile-ID-class MOCK adapter).
// The provider returns a verdict contract: liveness score, face-match against
// the government-anchored reference, consistency flag. No selfie pixels or
// biometric templates are ever stored — only the redacted verdict + a
// fingerprint of the subject linkage.
// ---------------------------------------------------------------------------

model LivenessSession {
  id              String    @id @default(cuid())
  userId          String
  trustIdentityId String?
  jobId           String    @unique // provider job reference (mock)
  status          String    @default("PENDING") // PENDING | PASSED | FAILED | EXPIRED
  result          String? // JSON verdict: passed, livenessScore, faceMatchScore, consistent, reason (redacted)
  confidence      Int? // provider confidence 0–100
  consentId       String // the consent that authorized this check
  expiresAt       DateTime // capture-window TTL (10 minutes)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Stage 8 — Trust Engine: rules-first, versioned, configurable scoring
// policy (audit §4.2). Every snapshot names the policy that produced it;
// policy changes are append-only (new version row) so old snapshots stay
// explainable forever. A DPIA record must cover the ACTIVE policy before
// automated significant decisions are allowed to ship (NDPC guidance gate).
// ---------------------------------------------------------------------------

model ScoringPolicy {
  id            String   @id @default(cuid())
  version       Int      @unique // 1, 2, 3 … append-only
  status        String   @default("DRAFT") // DRAFT | ACTIVE | RETIRED
  // Rules (all clamped at write time by the service — the engine never trusts
  // un-validated config): component budgets, thresholds, windows, penalties.
  rules         String // JSON: { assuranceBase, credentials, reputation, resolution, riskPenalty, statusThresholds, freshnessTtlHours … }
  changeSummary String // human-readable — what changed vs the prior version
  createdBy     String // admin handle/id (operational grant — never self-service)
  activatedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([status])
}

// Platform-level key/value settings (DPIA gate, future engine switches).
// Values are JSON strings; keys are engine-owned constants.
model PlatformSetting {
  key       String   @id
  value     String // JSON value
  updatedAt DateTime @updatedAt
}

// DPIA record — one per completed assessment. The ACTIVE scoring policy's
// DPIA must be `COMPLETED` (and not superseded) for the automated-decision
// gate to open. This is the NDPC-governance gate the audit demands.
model DpiaRecord {
  id            String   @id @default(cuid())
  policyId      String // the ScoringPolicy this assessment covers
  status        String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  summary       String // scope, risks, mitigations — human-readable registry entry
  residualRisk  String   @default("MEDIUM") // LOW | MEDIUM | HIGH (post-mitigation)
  checklist     String // JSON: [{id, label, done}] — governance evidence
  completedAt   DateTime?
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([policyId])
}

// ---------------------------------------------------------------------------
// Stage 5 — TrustScore snapshots (directive §35/§36 score contract).
// Formula: Identity Assurance + Verified Reputation + Verified Credentials +
// Resolution History − Confirmed Risk. Output: score, confidence, risk band,
// human-readable explanation (NDPA §37 automated-decision transparency) and
// freshness. Snapshots are immutable; a new row is written on material change
// or TTL expiry (24h), and only the last 20 per user are retained.
// Stage 8 adds the lifecycle: state (ACTIVE/STALE/FROZEN/RETIRED) + the
// policy that produced the snapshot (every score stays explainable) +
// freeze fields (appeal filed → frozen, appeal decided → recomputed).
// ---------------------------------------------------------------------------

model TrustScoreSnapshot {
  id          String   @id @default(cuid())
  userId      String
  version     Int      @default(1)
  status      String // NEW | VERIFIED | ESTABLISHED | CAUTION | HIGH_RISK | REVIEW_REQUIRED
  score       Int // 0–100
  confidence  Int // 0–100
  riskBand    String // LOW | MEDIUM | HIGH
  components  String // JSON: per-component {value, max, note}
  explanation String // JSON array of human-readable lines (NDPA §37)
  inputsHash  String // canonical hash of score inputs (change detection)
  trigger     String // INITIAL | MATERIAL_CHANGE | PERIODIC
  computedAt  DateTime @default(now())
  expiresAt   DateTime // snapshot freshness horizon (24h)
  state       String   @default("ACTIVE") // Stage 8: ACTIVE | STALE | FROZEN | RETIRED
  policyId    String? // Stage 8: the ScoringPolicy version that produced this
  frozenAt    DateTime?
  frozenReason String? // e.g. APPEAL_PENDING

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, computedAt])
}

// ---------------------------------------------------------------------------
// Stage 5 — Credentials (directive §6, wallet alignment).
// Platform-issued, evidence-backed assertions ("government identity verified",
// "phone verified", "liveness passed"). Claims are MASKED ONLY (hints/counts)
// — never attribute values, never raw identifiers. Credential never outlives
// its source evidence; user may revoke it manually at any time.
// ---------------------------------------------------------------------------

model Credential {
  id              String    @id @default(cuid())
  userId          String
  trustIdentityId String?
  type            String // GOV_ID_VERIFIED | PHONE_VERIFIED | LIVENESS_VERIFIED
  issuer          String // "TrustScore Platform" (issuer of record)
  issuerMode      String    @default("MOCK") // honesty: underlying providers are MOCK
  claims          String // JSON, masked only (hints/counts)
  status          String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  evidenceId      String? // provenance
  manualRevoked   Boolean   @default(false) // user-initiated revocation sticks
  issuedAt        DateTime  @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Stage 5 — Share tokens / Trust Link (directive §5 Trust Passport).
// The RAW token exists only transiently in the owner's UI (shown once at
// creation). At rest we keep sha256(raw) — lookup key for public views.
// Views are counted, bounded, expiring and revocable; every public view
// writes a TrustReceipt (who-checked-you log) for the owner.
// ---------------------------------------------------------------------------

model ShareToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique // sha256(raw token) — never the raw token
  scopes       String // JSON array: PROFILE | SIGNALS | ATTRIBUTES | SCORE
  maxViews     Int       @default(5)
  views        Int       @default(0)
  status       String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  expiresAt    DateTime
  revokedAt    DateTime?
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model TrustReceipt {
  id           String   @id @default(cuid())
  userId       String
  shareTokenId String?
  viewerLabel  String // e.g. "Trust link viewer" — no PII collected
  channel      String   @default("TRUST_LINK")
  cardShown    String // JSON: status/level/score shown at view time
  ipHash       String? // salted hash — abuse dedupe only, never displayed raw
  viewedAt     DateTime @default(now())

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
}

// ---------------------------------------------------------------------------
// Stage 5 — DSR requests (NDPA §36 data-subject rights, self-service).
// EXPORT: full data payload (hashes included — they ARE the stored data),
// downloadable for 7 days, then purged. DELETE: identity + account erased
// with cascade; only a redacted audit tombstone survives (legal basis).
// ---------------------------------------------------------------------------

model DsrRequest {
  id          String    @id @default(cuid())
  userId      String
  type        String // EXPORT | DELETE
  status      String    @default("PENDING") // PENDING | COMPLETED | REJECTED
  detail      String? // redacted summary
  payload     String? // EXPORT only: JSON payload (7-day retention)
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  expiresAt   DateTime? // export availability window

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
}

// ---------------------------------------------------------------------------
// Stage 6 — Safety Check (directive §2/§46 "Check Before You Deal").
// A signed-in VERIFIER runs a sanitized assessment on a subject via:
//   HANDLE        — the subject's @handle (requires their standing safety
//                   consent; anti-enumeration: "no such handle" and "checks
//                   disabled" are byte-identical responses)
//   PHONE         — consent-gated peppered-hash match against the subject's
//                   PHONE identifier (the raw phone is hashed and discarded;
//                   it is NEVER stored, logged or echoed)
//   TRUST_LINK/QR — an active Stage 5 share token / QR Trust Card payload
//                   (token scopes govern; the view is counted and receipted
//                   with the verifier's NAME — a named check)
// Every completed check writes a SafetyCheck row (the snapshot the verifier
// saw), a receipt + notification for the subject, and an audit event.
// The assessment NEVER says "this person is safe" (directive §50).
// ---------------------------------------------------------------------------

model SafetyCheck {
  id           String    @id @default(cuid())
  verifierId   String
  subjectId    String
  method       String // HANDLE | PHONE | TRUST_LINK | QR
  assessment   String // JSON snapshot of exactly what the verifier saw (sanitized, no raw identifiers)
  consentId    String? // standing SAFETY_CHECK consent that authorized a HANDLE/PHONE check
  shareTokenId String? // governing token for TRUST_LINK/QR checks
  ipHash       String? // salted — abuse dedupe only
  createdAt    DateTime  @default(now())

  verifier UserAccount @relation("SafetyChecksMade", fields: [verifierId], references: [id], onDelete: Cascade)
  subject  UserAccount @relation("SafetyChecksReceived", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([verifierId, createdAt])
  @@index([subjectId, createdAt])
}

// ---------------------------------------------------------------------------
// Stage 6 — Trust Requests (verifier-side ask). When a handle is not
// checkable (no standing consent), the verifier can ASK once: the subject
// accepts (a scoped trust link is minted and the assessment runs) or
// declines. Requests expire after 7 days; one pending request per pair.
// ---------------------------------------------------------------------------

model TrustRequest {
  id           String    @id @default(cuid())
  verifierId   String
  subjectId    String
  status       String    @default("PENDING") // PENDING | ACCEPTED | DECLINED | EXPIRED
  message      String // short preset ask — no free-text PII surface
  shareTokenId String? // minted on ACCEPT
  expiresAt    DateTime
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())

  verifier UserAccount @relation("TrustRequestsSent", fields: [verifierId], references: [id], onDelete: Cascade)
  subject  UserAccount @relation("TrustRequestsReceived", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, status])
  @@index([verifierId, createdAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256(token); the raw token exists only in the user's httpOnly cookie
  expiresAt DateTime
  userAgent String?
  ipHash    String? // salted hash of client IP — never raw IP
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


// ---------------------------------------------------------------------------
// Stage 7 — Reputation: Flags with evidence (directive §29 flags/flag_evidence).
// A flag is a REPORT TO THE PLATFORM about a member's conduct — never a
// public accusation: nothing about a flag is visible to anyone except the
// reporter, the subject and human reviewers. Anti-gaming by design
// (enforced in reputation-service):
//   * the reporter must hold a live L2+ Trust Identity (a verified human)
//   * one OPEN/UNDER_REVIEW flag per reporter→subject pair (409 duplicate)
//   * at most 3 flags per rolling 7-day window per reporter (429 window)
//   * at least one evidence item is mandatory at submission (422 zod)
//   * reporter identity is MASKED to the subject (retaliation shield);
//     the full record remains available via NDPA DSR export
// ---------------------------------------------------------------------------

model Flag {
  id                 String    @id @default(cuid())
  reporterId         String
  subjectId          String
  category           String // FRAUD | IMPERSONATION | NON_PAYMENT | SCAM | HARASSMENT | OTHER
  description        String // the reporter's claim — shown to subject + reviewer
  status             String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED_CONFIRMED | RESOLVED_UNFOUNDED | RESOLVED_DISMISSED | WITHDRAWN
  evidenceCount      Int       @default(0)
  subjectRespondedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  reporter   UserAccount     @relation("FlagsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  subject    UserAccount     @relation("FlagsReceived", fields: [subjectId], references: [id], onDelete: Cascade)
  evidence   FlagEvidence[]
  resolution FlagResolution?
  appeal     FlagAppeal?

  @@index([subjectId, status])
  @@index([reporterId, createdAt])
}

// Evidence items attached by either party. Content is their own statement or
// reference (text/link) — user data: shown to the two parties + reviewers,
// included in the DSR export, NEVER in audit metadata (directive §38).

model FlagEvidence {
  id            String   @id @default(cuid())
  flagId        String
  submittedById String
  role          String // REPORTER | SUBJECT — which side submitted it
  kind          String // TEXT | LINK
  content       String
  createdAt     DateTime @default(now())

  flag Flag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId])
}

// Human-reviewed resolution (directive §33 — no automated significant
// decisions in Stage 7). A REVIEWER decides CONFIRMED / UNFOUNDED / DISMISSED
// with a published rationale. CONFIRMED sets fraudSignal=true and feeds the
// score engine's Confirmed Risk component (−25 per confirmed flag, cap −50).

model FlagResolution {
  id          String   @id @default(cuid())
  flagId      String   @unique
  reviewerId  String
  outcome     String // CONFIRMED | UNFOUNDED | DISMISSED
  rationale   String // published to subject + reporter
  fraudSignal Boolean  @default(false) // true when outcome = CONFIRMED
  decidedAt   DateTime @default(now())

  reviewer UserAccount @relation("FlagResolutions", fields: [reviewerId], references: [id], onDelete: Cascade)
  flag     Flag        @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([reviewerId])
}

// Subject appeal of a CONFIRMED resolution — one per flag, 14-day window
// from the decision. UPHELD keeps the outcome; OVERTURNED flips the flag to
// RESOLVED_UNFOUNDED and restores the score (NDPA §37 redress path).

model FlagAppeal {
  id           String    @id @default(cuid())
  flagId       String    @unique
  appellantId  String // the flag subject
  reason       String
  status       String    @default("PENDING") // PENDING | UPHELD | OVERTURNED
  reviewerId   String?
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  appellant UserAccount @relation("FlagAppeals", fields: [appellantId], references: [id], onDelete: Cascade)
  flag      Flag        @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ---------------------------------------------------------------------------
// Stage 1 — Audit + notification plumbing (Security Center arrives Stage 5)
// ---------------------------------------------------------------------------

model AuditEvent {
  id          String   @id @default(cuid())
  actorType   String // USER | SYSTEM | ANONYMOUS
  actorId     String?
  action      String // AUTH_REGISTER | AUTH_LOGIN | AUTH_LOGIN_FAILED | AUTH_LOGOUT | ...
  subjectType String?
  subjectId   String?
  requestId   String?
  metadata    String? // JSON, redacted — no PII, no raw identifiers (directive §38)
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // SECURITY | VERIFICATION | SYSTEM
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
