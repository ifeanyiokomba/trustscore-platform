// TrustScore — NIN-First rebuild
// Stage 1–3 schema (per docs/STAGE0_AUDIT.md §4.3 / §4.2)
//
// Principle: UserAccount ≠ TrustIdentity ≠ NIN ≠ Phone (directive §29).
// Raw identity numbers (NIN, BVN, raw phone) are NEVER stored here.
// Stage 3 adds the Trust Identity management layer: hashed identifiers,
// consent-scoped attributes, evidence records with provenance + freshness.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Stage 1 — Accounts (authentication subjects)
// ---------------------------------------------------------------------------

model UserAccount {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String // scrypt output (never plaintext, never reversible)
  passwordSalt    String // per-user random salt
  displayName     String
  handle          String    @unique // reserved for future trustscore.ng/@handle Trust Link (Stage 5)
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED | PENDING_DELETION
  acceptedTermsAt DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions             Session[]
  notifications        Notification[]
  trustIdentity        TrustIdentity?
  verificationSessions VerificationSession[]
  consents             Consent[]
  evidence             Evidence[]

  @@index([email])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Stage 2 — NINAuth identity spine (contract-first, MOCK provider)
// Raw NIN / raw identifiers are NEVER stored. The provider returns only a
// masked subject reference (providerIdentityRef) + verification outcome.
// ---------------------------------------------------------------------------

model TrustIdentity {
  id                  String    @id @default(cuid())
  userId              String    @unique
  status              String    @default("PENDING") // PENDING | VERIFIED | EXPIRED | REVOKED
  assuranceLevel      Int       @default(0) // 0 = none; 1 = government-verified via NINAuth; L2 phone/L3 biometric arrive Stage 4; L4 cross-signal
  provider            String    @default("NINAUTH_MOCK")
  providerMode        String    @default("MOCK") // MOCK until partner sandbox creds exist (audit §2.2)
  providerIdentityRef String? // masked subject from provider — never a raw NIN
  establishingConsentId String? // the consent that established this identity (withdrawal semantics, Stage 3)
  verifiedAt          DateTime?
  expiresAt           DateTime? // verification freshness horizon (90 days)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user        UserAccount          @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifiers IdentityIdentifier[]
  attributes  IdentityAttribute[]
  evidence    Evidence[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Stage 3 — Identity identifiers (HASHED — directive §29 identity_identifiers)
// We store only peppered sha256 fingerprints for future match lookops
// (Stage 6 Safety Check) — never raw NIN/phone values.
// ---------------------------------------------------------------------------

model IdentityIdentifier {
  id              String    @id @default(cuid())
  trustIdentityId String
  type            String // NIN_FINGERPRINT | PHONE | EMAIL — signal family
  hash            String // sha256(pepper + provider subject / normalized value) — NEVER raw
  hint            String // masked display hint, e.g. "Government ID · NINAuth ref"
  status          String    @default("ACTIVE") // ACTIVE | REVOKED | SUPERSEDED
  verifiedAt      DateTime
  expiresAt       DateTime? // identifier freshness horizon
  consentId       String? // provenance
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trustIdentity TrustIdentity @relation(fields: [trustIdentityId], references: [id], onDelete: Cascade)

  @@unique([trustIdentityId, type])
  @@index([hash])
}

// ---------------------------------------------------------------------------
// Stage 3 — Identity attributes (CONSENT-SCOPED — directive §29/§31)
// An attribute exists only while the consent that produced it stands.
// Withdrawing the consent revokes the attribute (NDPA data-subject right).
// ---------------------------------------------------------------------------

model IdentityAttribute {
  id              String    @id @default(cuid())
  trustIdentityId String
  key             String // given_name | family_name | birth_year | state_of_origin | ...
  value           String // consent-scoped display value
  scope           String // the consent scope that produced this attribute
  consentId       String // provenance — withdraw the consent, revoke the attribute
  status          String    @default("ACTIVE") // ACTIVE | REVOKED
  source          String // provider that asserted the value
  assertedAt      DateTime // when the provider asserted it
  expiresAt       DateTime? // attribute freshness (follows identity horizon)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trustIdentity TrustIdentity @relation(fields: [trustIdentityId], references: [id], onDelete: Cascade)

  @@unique([trustIdentityId, key])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Stage 3 — Evidence records (provenance + freshness — directive §29 evidence)
// Verified evidence with chain: which session produced it, under which consent,
// from which provider, with what confidence, valid until when.
// ---------------------------------------------------------------------------

model Evidence {
  id              String    @id @default(cuid())
  userId          String
  trustIdentityId String?
  sessionId       String? // verification session provenance
  consentId       String? // consent provenance
  type            String // NINAUTH_ID_TOKEN | PHONE_OTP | LIVENESS (Stage 4) | ...
  provider        String
  providerMode    String
  summary         String // redacted human summary — no PII (directive §38)
  confidence      Int       @default(100) // 0–100 provider confidence
  status          String    @default("ACTIVE") // ACTIVE | REVOKED
  collectedAt     DateTime
  expiresAt       DateTime? // evidence freshness
  createdAt       DateTime  @default(now())

  user          UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  trustIdentity TrustIdentity? @relation(fields: [trustIdentityId], references: [id], onDelete: SetNull)

  @@index([userId, collectedAt])
  @@index([trustIdentityId])
  @@index([status])
}

model VerificationSession {
  id                    String    @id @default(cuid())
  userId                String
  provider              String    @default("NINAUTH_MOCK")
  providerMode          String    @default("MOCK")
  flow                  String    @default("QR") // QR | SHARE_CODE
  status                String    @default("AWAITING_CONSENT") // AWAITING_CONSENT | CONSENT_GRANTED | CONSENT_DENIED | COMPLETED | FAILED | EXPIRED
  state                 String    @unique // OAuth state / anti-CSRF (also used as nonce)
  codeVerifier          String // PKCE verifier — SERVER-SIDE ONLY, never sent to any client
  codeChallenge         String // S256(verifier)
  authorizationCodeHash String? // one-time code issued by the provider (mock NINAuth app)
  authorizationCodeExp  DateTime?
  scopes                String // JSON array requested/granted
  purpose               String
  policyVersion         String
  shareCode             String    @unique // NINAuth-style share code for the user to present
  authorizationUrl      String // provider authorize URL (mock endpoint shape in sandbox)
  errorReason           String?
  consentId             String?
  expiresAt             DateTime // session TTL (10 min, like an authorize flow)
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  events VerificationEvent[]
  user  UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model VerificationEvent {
  id        String   @id @default(cuid())
  sessionId String
  eventType String // SESSION_CREATED | CONSENT_SCREEN_PRESENTED | CONSENT_GRANTED | CONSENT_DENIED | CODE_ISSUED | CODE_EXCHANGED | TOKEN_VALIDATED | IDENTITY_VERIFIED | SESSION_FAILED | SESSION_EXPIRED
  detail    String? // redacted JSON — no PII (directive §38)
  createdAt DateTime @default(now())

  session VerificationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// Consent record per directive §31: who requested, why, what scopes were
// requested/granted, when, which provider, policy version.
model Consent {
  id           String    @id @default(cuid())
  userId       String
  sessionId    String?   @unique
  requester    String // who requested the identity access
  purpose      String
  scopes       String // JSON array granted
  policyVersion String
  grantedAt    DateTime  @default(now())
  withdrawnAt  DateTime?
  createdAt    DateTime  @default(now())

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256(token); the raw token exists only in the user's httpOnly cookie
  expiresAt DateTime
  userAgent String?
  ipHash    String? // salted hash of client IP — never raw IP
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Stage 1 — Audit + notification plumbing (Security Center arrives Stage 5)
// ---------------------------------------------------------------------------

model AuditEvent {
  id          String   @id @default(cuid())
  actorType   String // USER | SYSTEM | ANONYMOUS
  actorId     String?
  action      String // AUTH_REGISTER | AUTH_LOGIN | AUTH_LOGIN_FAILED | AUTH_LOGOUT | ...
  subjectType String?
  subjectId   String?
  requestId   String?
  metadata    String? // JSON, redacted — no PII, no raw identifiers (directive §38)
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // SECURITY | VERIFICATION | SYSTEM
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
